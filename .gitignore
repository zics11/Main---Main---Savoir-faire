# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite database (Docker volume in production)
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm

# uploaded images (Docker volume in production)
/uploads/*
!/uploads/.gitkeep

# Journal du serveur de dev lancé en arrière-plan
.next-dev.log
